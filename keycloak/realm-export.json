{
  "realm": "drm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "deptmanager" },
      { "name": "employee" }
    ]
  },
  "clients": [
    {
      "clientId": "drm-web",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://app.drm.localhost/*"],
      "webOrigins": ["http://app.drm.localhost"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "testpass", "temporary": false }
      ],
      "realmRoles": ["employee"]
    }
  ]
}

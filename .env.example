POSTGRES_USER=drm
POSTGRES_PASSWORD=drm_dev_password
POSTGRES_DB=drm

# Base domain suffix for all service hostnames (app./api./auth./storage.<this>).
# `*.localhost` always resolves to 127.0.0.1 in Chrome (it ignores hosts-file
# overrides for that TLD), so if you need to reach this stack from another
# machine on your LAN, override this in your own .env with a real hostname
# that resolves to this host (e.g. via /etc/hosts or your LAN's DNS).
DRM_BASE_DOMAIN=drm.localhost
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
MINIO_ROOT_USER=drm-admin
MINIO_ROOT_PASSWORD=drm_dev_minio_password
# Scoped credential for the Phase 2B API (read/write/list/delete on the
# 'documents' bucket only -- see minio/drm-api-policy.json). Not root.
MINIO_API_ACCESS_KEY=drm-api
MINIO_API_SECRET_KEY=drm_dev_api_password

# Phase: Backup & Disaster Recovery
BACKUP_SSH_TARGET=backupuser@nas.internal:/backups/drm
BACKUP_SSH_KEY_PATH=secrets/backup-ssh/id_ed25519
BACKUP_RETENTION_DAYS=14
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_SMTP_HOST=smtp.example.com
BACKUP_SMTP_PORT=587
BACKUP_SMTP_USER=backup@example.com
BACKUP_NOTIFY_EMAIL_FROM=backup@example.com
BACKUP_NOTIFY_EMAIL_TO=ops@example.com
